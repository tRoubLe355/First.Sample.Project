@page
@model bitirme__projesi.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Sepetim";
}

<section class="py-5">
    <div class="container">
        <h1 class="h2 fw-bold text-primary mb-4">
            <span class="material-symbols-outlined align-middle me-2">shopping_cart</span>
            Sepetim
        </h1>

        @if (Model.Cart != null && Model.Cart.CartItems.Any())
        {
            <div class="row g-4">
                <!-- Sepet Öğeleri -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="border-0 ps-4">Ürün</th>
                                            <th class="border-0 text-center">Fiyat</th>
                                            <th class="border-0 text-center">Adet</th>
                                            <th class="border-0 text-center">Toplam</th>
                                            <th class="border-0"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Cart.CartItems)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                                        {
                                                            <img src="@item.Product.ImageUrl" alt="@item.Product?.Name" 
                                                                 class="rounded" style="width: 60px; height: 60px; object-fit: cover;">
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                                                                 style="width: 60px; height: 60px;">
                                                                <span class="material-symbols-outlined text-muted">spa</span>
                                                            </div>
                                                        }
                                                        <div>
                                                            <a asp-page="/Products/Details" asp-route-id="@item.ProductId" 
                                                               class="fw-medium text-decoration-none text-dark">
                                                                @item.Product?.Name
                                                            </a>
                                                            <p class="text-muted small mb-0">@item.Product?.Category?.Name</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center">₺@item.UnitPrice.ToString("N2")</td>
                                                <td class="text-center">
                                                    <form method="post" asp-page-handler="UpdateQuantity" class="d-inline">
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <div class="input-group input-group-sm" style="width: 100px; margin: 0 auto;">
                                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)" 
                                                                    class="btn btn-outline-secondary">-</button>
                                                            <span class="form-control text-center">@item.Quantity</span>
                                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)" 
                                                                    class="btn btn-outline-secondary">+</button>
                                                        </div>
                                                    </form>
                                                </td>
                                                <td class="text-center fw-bold">₺@item.TotalPrice.ToString("N2")</td>
                                                <td class="text-end pe-4">
                                                    <form method="post" asp-page-handler="RemoveItem" class="d-inline">
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <button type="submit" class="btn btn-link text-danger p-0">
                                                            <span class="material-symbols-outlined">delete</span>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <form method="post" asp-page-handler="ClearCart" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <span class="material-symbols-outlined align-middle me-1" style="font-size: 18px;">remove_shopping_cart</span>
                                Sepeti Temizle
                            </button>
                        </form>
                        <a asp-page="/Products/Index" class="btn btn-outline-primary btn-sm">
                            <span class="material-symbols-outlined align-middle me-1" style="font-size: 18px;">arrow_back</span>
                            Alışverişe Devam Et
                        </a>
                    </div>
                </div>

                <!-- Sipariş Özeti -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Sipariş Özeti</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Ara Toplam</span>
                                <span>₺@Model.Cart.TotalAmount.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Kargo</span>
                                @if (Model.Cart.TotalAmount >= 100)
                                {
                                    <span class="text-success">Ücretsiz</span>
                                }
                                else
                                {
                                    <span>₺19.90</span>
                                }
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="fw-bold">Toplam</span>
                                <span class="fw-bold text-primary fs-4">
                                    ₺@((Model.Cart.TotalAmount + (Model.Cart.TotalAmount >= 100 ? 0 : 19.90m)).ToString("N2"))
                                </span>
                            </div>
                            @if (Model.Cart.TotalAmount < 100)
                            {
                                <div class="alert alert-info small mb-3">
                                    <span class="material-symbols-outlined align-middle me-1" style="font-size: 16px;">info</span>
                                    ₺@((100 - Model.Cart.TotalAmount).ToString("N2")) daha ekleyin, kargo bedava!
                                </div>
                            }
                            <a asp-page="/Checkout/Index" class="btn btn-primary w-100 btn-lg">
                                <span class="material-symbols-outlined align-middle me-2">payment</span>
                                Ödemeye Geç
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <span class="material-symbols-outlined text-muted" style="font-size: 6rem;">shopping_cart</span>
                <h3 class="mt-3 text-muted">Sepetiniz boş</h3>
                <p class="text-muted mb-4">Henüz sepetinize ürün eklemediniz.</p>
                <a asp-page="/Products/Index" class="btn btn-primary btn-lg">
                    <span class="material-symbols-outlined align-middle me-2">shopping_bag</span>
                    Alışverişe Başla
                </a>
            </div>
        }
    </div>
</section>

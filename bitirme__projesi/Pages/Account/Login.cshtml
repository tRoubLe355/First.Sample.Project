@page
@model bitirme__projesi.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <span class="material-symbols-outlined text-primary" style="font-size: 3rem;">account_circle</span>
                            <h2 class="h3 fw-bold text-primary mt-3">Giriş Yap</h2>
                            <p class="text-muted">Hesabınıza giriş yapın</p>
                        </div>

                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            
                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label fw-medium">E-posta</label>
                                <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="ornek@email.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label fw-medium">Şifre</label>
                                <input asp-for="Input.Password" class="form-control form-control-lg" placeholder="••••••••" />
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4 form-check">
                                <input asp-for="Input.RememberMe" class="form-check-input" />
                                <label asp-for="Input.RememberMe" class="form-check-label">Beni hatırla</label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                                <span class="material-symbols-outlined align-middle me-2">login</span>
                                Giriş Yap
                            </button>
                        </form>

                        <div class="text-center">
                            <p class="mb-0 text-muted">
                                Hesabınız yok mu? 
                                <a asp-page="/Account/Register" class="text-primary fw-medium text-decoration-none">Kayıt Ol</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model bitirme__projesi.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <span class="material-symbols-outlined text-primary" style="font-size: 3rem;">person_add</span>
                            <h2 class="h3 fw-bold text-primary mt-3">Kayıt Ol</h2>
                            <p class="text-muted">Yeni bir hesap oluşturun</p>
                        </div>

                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.FirstName" class="form-label fw-medium">Ad</label>
                                    <input asp-for="Input.FirstName" class="form-control form-control-lg" placeholder="Adınız" />
                                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.LastName" class="form-label fw-medium">Soyad</label>
                                    <input asp-for="Input.LastName" class="form-control form-control-lg" placeholder="Soyadınız" />
                                    <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label fw-medium">E-posta</label>
                                <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="ornek@email.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label fw-medium">Şifre</label>
                                <input asp-for="Input.Password" class="form-control form-control-lg" placeholder="••••••••" />
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Input.ConfirmPassword" class="form-label fw-medium">Şifre Tekrar</label>
                                <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" placeholder="••••••••" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                                <span class="material-symbols-outlined align-middle me-2">how_to_reg</span>
                                Kayıt Ol
                            </button>
                        </form>

                        <div class="text-center">
                            <p class="mb-0 text-muted">
                                Zaten hesabınız var mı? 
                                <a asp-page="/Account/Login" class="text-primary fw-medium text-decoration-none">Giriş Yap</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

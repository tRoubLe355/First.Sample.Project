@page
@model bitirme__projesi.Pages.AboutModel
@{
    ViewData["Title"] = "Hakkımızda";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center mb-5">
                <span class="text-gold fw-bold text-uppercase small" style="letter-spacing: 2px">Hikayemiz</span>
                <h1 class="text-primary display-4 fw-bold mt-2">Hakkımızda</h1>
                <div class="section-separator mx-auto"></div>
            </div>
        </div>

        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1500076656116-558758c991c1?w=600" 
                     alt="Organik Çiftlik" class="img-fluid rounded shadow">
            </div>
            <div class="col-lg-6">
                <h2 class="h3 fw-bold text-primary mb-4">Doğaya Olan Tutkumuz</h2>
                <p class="text-muted fs-5" style="line-height: 1.8">
                    Natura, 2026 yılında organik ve doğal ürünlere olan tutkumuzla kuruldu. 
                    Amacımız, insanların sağlıklı ve doğal gıdalara kolayca ulaşmasını sağlamak.
                </p>
                <p class="text-muted fs-5" style="line-height: 1.8">
                    Yerel çiftçilerle el ele çalışarak, toprağa saygılı tarım yöntemleriyle 
                    yetiştirilen ürünleri sofralarınıza taşıyoruz.
                </p>
            </div>
        </div>

        <div class="row g-5 align-items-center">
            <div class="col-lg-6 order-lg-2">
                <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?w=600" 
                     alt="Taze Ürünler" class="img-fluid rounded shadow">
            </div>
            <div class="col-lg-6 order-lg-1">
                <h2 class="h3 fw-bold text-primary mb-4">Sürdürülebilir Gelecek</h2>
                <p class="text-muted fs-5" style="line-height: 1.8">
                    Çevre dostu ambalaj malzemeleri kullanıyor, karbon ayak izimizi minimize ediyoruz.
                    Her satın alımınızla, daha yeşil bir gelecek için birlikte adım atıyoruz.
                </p>
                <div class="row g-4 mt-4">
                    <div class="col-6">
                        <div class="text-center">
                            <span class="material-symbols-outlined text-primary" style="font-size: 3rem;">eco</span>
                            <h4 class="h2 fw-bold text-primary mt-2">%100</h4>
                            <p class="text-muted small">Organik Ürünler</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center">
                            <span class="material-symbols-outlined text-primary" style="font-size: 3rem;">groups</span>
                            <h4 class="h2 fw-bold text-primary mt-2">50+</h4>
                            <p class="text-muted small">Yerel Çiftçi</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

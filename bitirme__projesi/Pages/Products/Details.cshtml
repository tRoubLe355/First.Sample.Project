@page "{id:int}"
@model bitirme__projesi.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Ürün Detayı";
}

@if (Model.Product != null)
{
    <section class="py-5">
        <div class="container">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Ana Sayfa</a></li>
                    <li class="breadcrumb-item"><a asp-page="/Products/Index" class="text-decoration-none">Ürünler</a></li>
                    @if (Model.Product.Category != null)
                    {
                        <li class="breadcrumb-item">
                            <a asp-page="/Products/Index" asp-route-categoryId="@Model.Product.CategoryId" class="text-decoration-none">
                                @Model.Product.Category.Name
                            </a>
                        </li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
                </ol>
            </nav>

            <div class="row g-5">
                <!-- Ürün Görseli -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                        {
                            <img src="@Model.Product.ImageUrl" class="card-img-top" alt="@Model.Product.Name"
                                 style="max-height: 500px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
                                <span class="material-symbols-outlined text-muted" style="font-size: 8rem;">spa</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Ürün Bilgileri -->
                <div class="col-lg-6">
                    <div class="d-flex gap-2 mb-3">
                        @if (Model.Product.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark">
                                <span class="material-symbols-outlined align-middle me-1" style="font-size: 14px;">star</span>
                                Öne Çıkan
                            </span>
                        }
                        @if (Model.Product.DiscountPrice.HasValue)
                        {
                            <span class="badge bg-danger">İndirimli</span>
                        }
                        <span class="badge bg-success">
                            <span class="material-symbols-outlined align-middle me-1" style="font-size: 14px;">eco</span>
                            %100 Organik
                        </span>
                    </div>

                    <h1 class="h2 fw-bold mb-3">@Model.Product.Name</h1>
                    
                    @if (Model.Product.Category != null)
                    {
                        <p class="text-muted mb-3">
                            <span class="material-symbols-outlined align-middle me-1">category</span>
                            @Model.Product.Category.Name
                        </p>
                    }

                    <div class="mb-4">
                        @if (Model.Product.DiscountPrice.HasValue)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <span class="text-decoration-line-through text-muted fs-4">₺@Model.Product.Price.ToString("N2")</span>
                                <span class="text-primary fw-bold" style="font-size: 2.5rem;">₺@Model.Product.DiscountPrice.Value.ToString("N2")</span>
                            </div>
                            <p class="text-success small mb-0">
                                <span class="material-symbols-outlined align-middle me-1" style="font-size: 16px;">savings</span>
                                ₺@((Model.Product.Price - Model.Product.DiscountPrice.Value).ToString("N2")) tasarruf edin!
                            </p>
                        }
                        else
                        {
                            <span class="text-primary fw-bold" style="font-size: 2.5rem;">₺@Model.Product.Price.ToString("N2")</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Product.Unit))
                        {
                            <span class="text-muted fs-5">/ @Model.Product.Unit</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Product.Description))
                    {
                        <div class="mb-4">
                            <h5 class="fw-bold mb-2">Ürün Açıklaması</h5>
                            <p class="text-muted">@Model.Product.Description</p>
                        </div>
                    }

                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="material-symbols-outlined text-success">inventory</span>
                            @if (Model.Product.Stock > 10)
                            {
                                <span class="text-success fw-medium">Stokta var</span>
                            }
                            else if (Model.Product.Stock > 0)
                            {
                                <span class="text-warning fw-medium">Son @Model.Product.Stock adet!</span>
                            }
                            else
                            {
                                <span class="text-danger fw-medium">Stokta yok</span>
                            }
                        </div>
                    </div>

                    <form method="post" asp-page-handler="AddToCart" class="mb-4">
                        <input type="hidden" name="productId" value="@Model.Product.Id" />
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <label class="form-label fw-medium mb-0">Adet:</label>
                            </div>
                            <div class="col-auto">
                                <input type="number" name="quantity" value="1" min="1" max="@Model.Product.Stock" 
                                       class="form-control" style="width: 80px;" @(Model.Product.Stock <= 0 ? "disabled" : "") />
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-primary btn-lg w-100" @(Model.Product.Stock <= 0 ? "disabled" : "")>
                                    <span class="material-symbols-outlined align-middle me-2">add_shopping_cart</span>
                                    Sepete Ekle
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="border-top pt-4">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">local_shipping</span>
                                    <small class="text-muted">Ücretsiz kargo (₺100+)</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">verified</span>
                                    <small class="text-muted">Kalite garantisi</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">sync</span>
                                    <small class="text-muted">7 gün iade hakkı</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">support_agent</span>
                                    <small class="text-muted">7/24 destek</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="py-5">
        <div class="container text-center">
            <span class="material-symbols-outlined text-muted" style="font-size: 5rem;">search_off</span>
            <h2 class="mt-3">Ürün bulunamadı</h2>
            <p class="text-muted">Aradığınız ürün mevcut değil veya kaldırılmış olabilir.</p>
            <a asp-page="/Products/Index" class="btn btn-primary">Ürünlere Dön</a>
        </div>
    </section>
}

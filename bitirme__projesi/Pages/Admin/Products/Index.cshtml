@page
@model bitirme__projesi.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Ürün Yönetimi";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">Tüm Ürünler (@Model.Products.Count())</h5>
    <a asp-page="/Admin/Products/Create" class="btn btn-primary">
        <span class="material-symbols-outlined align-middle me-1">add</span>
        Yeni Ürün
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0">Ürün</th>
                        <th class="border-0">Kategori</th>
                        <th class="border-0 text-center">Fiyat</th>
                        <th class="border-0 text-center">Stok</th>
                        <th class="border-0 text-center">Durum</th>
                        <th class="border-0 text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="rounded" style="width: 40px; height: 40px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <span class="material-symbols-outlined text-muted" style="font-size: 20px;">spa</span>
                                        </div>
                                    }
                                    <span class="fw-medium">@product.Name</span>
                                </div>
                            </td>
                            <td>@product.Category?.Name</td>
                            <td class="text-center">
                                @if (product.DiscountPrice.HasValue)
                                {
                                    <span class="text-decoration-line-through text-muted small">₺@product.Price.ToString("N2")</span>
                                    <br>
                                    <span class="fw-medium text-success">₺@product.DiscountPrice.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="fw-medium">₺@product.Price.ToString("N2")</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (product.Stock > 10)
                                {
                                    <span class="badge bg-success">@product.Stock</span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class="badge bg-warning text-dark">@product.Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (product.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="/Admin/Products/Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@product.Id" class="d-inline" 
                                      onsubmit="return confirm('Bu ürünü silmek istediğinizden emin misiniz?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@page
@model bitirme__projesi.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">Tüm Siparişler (@Model.Orders.Count())</h5>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0">Sipariş No</th>
                        <th class="border-0">Müşteri</th>
                        <th class="border-0">Tarih</th>
                        <th class="border-0 text-center">Tutar</th>
                        <th class="border-0 text-center">Durum</th>
                        <th class="border-0 text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td class="fw-medium">@order.OrderNumber</td>
                            <td>
                                @order.User?.FirstName @order.User?.LastName
                                <br>
                                <small class="text-muted">@order.User?.Email</small>
                            </td>
                            <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-center fw-bold">₺@order.TotalAmount.ToString("N2")</td>
                            <td class="text-center">
                                @{
                                    var statusClass = order.Status switch
                                    {
                                        Natura.Entity.OrderStatus.Pending => "bg-warning text-dark",
                                        Natura.Entity.OrderStatus.Processing => "bg-info",
                                        Natura.Entity.OrderStatus.Shipped => "bg-primary",
                                        Natura.Entity.OrderStatus.Delivered => "bg-success",
                                        Natura.Entity.OrderStatus.Cancelled => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                    var statusText = order.Status switch
                                    {
                                        Natura.Entity.OrderStatus.Pending => "Beklemede",
                                        Natura.Entity.OrderStatus.Processing => "Hazırlanıyor",
                                        Natura.Entity.OrderStatus.Shipped => "Kargoda",
                                        Natura.Entity.OrderStatus.Delivered => "Teslim Edildi",
                                        Natura.Entity.OrderStatus.Cancelled => "İptal",
                                        _ => "?"
                                    };
                                }
                                <span class="badge @statusClass">@statusText</span>
                            </td>
                            <td class="text-end">
                                <a asp-page="/Admin/Orders/Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">visibility</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

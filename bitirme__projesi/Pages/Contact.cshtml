@page
@model bitirme__projesi.Pages.ContactModel
@{
    ViewData["Title"] = "İletişim";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center mb-5">
                <span class="text-gold fw-bold text-uppercase small" style="letter-spacing: 2px">Bize Ulaşın</span>
                <h1 class="text-primary display-4 fw-bold mt-2">İletişim</h1>
                <div class="section-separator mx-auto"></div>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h3 class="h4 fw-bold text-primary mb-4">İletişim Bilgileri</h3>
                        
                        <div class="d-flex gap-3 mb-4">
                            <span class="material-symbols-outlined text-primary">location_on</span>
                            <div>
                                <h5 class="fw-bold mb-1">Adres</h5>
                                <p class="text-muted mb-0">İstanbul, Türkiye<br>Kadıköy, Moda Caddesi No:123</p>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mb-4">
                            <span class="material-symbols-outlined text-primary">phone</span>
                            <div>
                                <h5 class="fw-bold mb-1">Telefon</h5>
                                <p class="text-muted mb-0">+90 (216) 123 45 67</p>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mb-4">
                            <span class="material-symbols-outlined text-primary">mail</span>
                            <div>
                                <h5 class="fw-bold mb-1">E-posta</h5>
                                <p class="text-muted mb-0">info@natura.com.tr</p>
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <span class="material-symbols-outlined text-primary">schedule</span>
                            <div>
                                <h5 class="fw-bold mb-1">Çalışma Saatleri</h5>
                                <p class="text-muted mb-0">Pazartesi - Cumartesi: 09:00 - 18:00<br>Pazar: Kapalı</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h3 class="h4 fw-bold text-primary mb-4">Bize Mesaj Gönderin</h3>
                        <form>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Adınız</label>
                                    <input type="text" class="form-control" placeholder="Adınız Soyadınız">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">E-posta</label>
                                    <input type="email" class="form-control" placeholder="ornek@email.com">
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-medium">Konu</label>
                                    <input type="text" class="form-control" placeholder="Mesajınızın konusu">
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-medium">Mesajınız</label>
                                    <textarea class="form-control" rows="5" placeholder="Mesajınızı buraya yazın..."></textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary btn-lg w-100">
                                        <span class="material-symbols-outlined align-middle me-2">send</span>
                                        Gönder
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@page
@model bitirme__projesi.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Siparişlerim";
}

<section class="py-5">
    <div class="container">
        <h1 class="h2 fw-bold text-primary mb-4">
            <span class="material-symbols-outlined align-middle me-2">receipt_long</span>
            Siparişlerim
        </h1>

        @if (Model.Orders.Any())
        {
            <div class="row g-4">
                @foreach (var order in Model.Orders)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                                <div>
                                    <span class="fw-bold">Sipariş #@order.OrderNumber</span>
                                    <span class="text-muted ms-2">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    @{
                                        var statusClass = order.Status switch
                                        {
                                            Natura.Entity.OrderStatus.Pending => "bg-warning text-dark",
                                            Natura.Entity.OrderStatus.Processing => "bg-info text-white",
                                            Natura.Entity.OrderStatus.Shipped => "bg-primary text-white",
                                            Natura.Entity.OrderStatus.Delivered => "bg-success text-white",
                                            Natura.Entity.OrderStatus.Cancelled => "bg-danger text-white",
                                            _ => "bg-secondary text-white"
                                        };
                                        var statusText = order.Status switch
                                        {
                                            Natura.Entity.OrderStatus.Pending => "Beklemede",
                                            Natura.Entity.OrderStatus.Processing => "Hazırlanıyor",
                                            Natura.Entity.OrderStatus.Shipped => "Kargoda",
                                            Natura.Entity.OrderStatus.Delivered => "Teslim Edildi",
                                            Natura.Entity.OrderStatus.Cancelled => "İptal Edildi",
                                            _ => "Bilinmiyor"
                                        };
                                    }
                                    <span class="badge @statusClass">@statusText</span>
                                    <span class="fw-bold text-primary">₺@order.TotalAmount.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <div class="col-12 col-md-6 col-lg-4">
                                            <div class="d-flex align-items-center gap-3 p-2 bg-light rounded">
                                                @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                                {
                                                    <img src="@item.Product.ImageUrl" alt="@item.Product?.Name" 
                                                         class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-white rounded d-flex align-items-center justify-content-center" 
                                                         style="width: 50px; height: 50px;">
                                                        <span class="material-symbols-outlined text-muted">spa</span>
                                                    </div>
                                                }
                                                <div class="flex-grow-1">
                                                    <p class="mb-0 fw-medium small">@item.Product?.Name</p>
                                                    <p class="mb-0 text-muted small">
                                                        @item.Quantity x ₺@item.UnitPrice.ToString("N2")
                                                    </p>
                                                </div>
                                                <span class="fw-medium small">₺@item.TotalPrice.ToString("N2")</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <hr class="my-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="small text-muted mb-1">Teslimat Adresi</p>
                                        <p class="mb-0">
                                            @order.ShippingAddress, @order.ShippingCity @order.ShippingPostalCode
                                            <br>
                                            <span class="text-muted">Tel: @order.ShippingPhone</span>
                                        </p>
                                    </div>
                                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                        <a asp-page="/Orders/Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                            <span class="material-symbols-outlined align-middle me-1" style="font-size: 16px;">visibility</span>
                                            Detayları Gör
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <span class="material-symbols-outlined text-muted" style="font-size: 6rem;">receipt_long</span>
                <h3 class="mt-3 text-muted">Henüz siparişiniz yok</h3>
                <p class="text-muted mb-4">İlk alışverişinizi yaparak başlayın!</p>
                <a asp-page="/Products/Index" class="btn btn-primary btn-lg">
                    <span class="material-symbols-outlined align-middle me-2">shopping_bag</span>
                    Alışverişe Başla
                </a>
            </div>
        }
    </div>
</section>

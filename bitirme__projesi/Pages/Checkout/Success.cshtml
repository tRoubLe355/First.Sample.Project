@page "{orderId:int}"
@model bitirme__projesi.Pages.Checkout.SuccessModel
@{
    ViewData["Title"] = "Sipariş Tamamlandı";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 text-center">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <span class="material-symbols-outlined text-success" style="font-size: 6rem;">check_circle</span>
                        </div>
                        <h1 class="h2 fw-bold text-primary mb-3">Siparişiniz Alındı!</h1>
                        <p class="text-muted mb-4">
                            Siparişiniz başarıyla oluşturuldu. Siparişinizin durumunu 
                            "Siparişlerim" sayfasından takip edebilirsiniz.
                        </p>

                        @if (Model.Order != null)
                        {
                            <div class="bg-light rounded p-4 mb-4 text-start">
                                <div class="row g-3">
                                    <div class="col-6">
                                        <span class="text-muted small">Sipariş Numarası</span>
                                        <p class="fw-bold mb-0">@Model.Order.OrderNumber</p>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted small">Sipariş Tarihi</span>
                                        <p class="fw-medium mb-0">@Model.Order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted small">Toplam Tutar</span>
                                        <p class="fw-bold text-primary mb-0">₺@Model.Order.TotalAmount.ToString("N2")</p>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted small">Durum</span>
                                        <p class="mb-0">
                                            <span class="badge bg-warning text-dark">Beklemede</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex gap-3 justify-content-center">
                            <a asp-page="/Orders/Index" class="btn btn-primary">
                                <span class="material-symbols-outlined align-middle me-2">receipt_long</span>
                                Siparişlerim
                            </a>
                            <a asp-page="/Products/Index" class="btn btn-outline-primary">
                                <span class="material-symbols-outlined align-middle me-2">shopping_bag</span>
                                Alışverişe Devam
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

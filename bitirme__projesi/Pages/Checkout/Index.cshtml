@page
@model bitirme__projesi.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Ödeme";
}

<section class="py-5">
    <div class="container">
        <h1 class="h2 fw-bold text-primary mb-4">
            <span class="material-symbols-outlined align-middle me-2">payment</span>
            Ödeme
        </h1>

        @if (Model.Cart != null && Model.Cart.CartItems.Any())
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row g-4">
                    <!-- Teslimat Bilgileri -->
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-white border-0 pt-4">
                                <h5 class="mb-0">
                                    <span class="material-symbols-outlined align-middle me-2">local_shipping</span>
                                    Teslimat Bilgileri
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label asp-for="Input.ShippingAddress" class="form-label fw-medium">Adres</label>
                                        <textarea asp-for="Input.ShippingAddress" class="form-control" rows="2" 
                                                  placeholder="Sokak, mahalle, bina no, daire no..."></textarea>
                                        <span asp-validation-for="Input.ShippingAddress" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Input.ShippingCity" class="form-label fw-medium">Şehir</label>
                                        <input asp-for="Input.ShippingCity" class="form-control" placeholder="İstanbul" />
                                        <span asp-validation-for="Input.ShippingCity" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Input.ShippingPostalCode" class="form-label fw-medium">Posta Kodu</label>
                                        <input asp-for="Input.ShippingPostalCode" class="form-control" placeholder="34000" />
                                        <span asp-validation-for="Input.ShippingPostalCode" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Input.ShippingPhone" class="form-label fw-medium">Telefon</label>
                                        <input asp-for="Input.ShippingPhone" class="form-control" placeholder="0532 123 45 67" />
                                        <span asp-validation-for="Input.ShippingPhone" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white border-0 pt-4">
                                <h5 class="mb-0">
                                    <span class="material-symbols-outlined align-middle me-2">credit_card</span>
                                    Ödeme Bilgileri
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info">
                                    <span class="material-symbols-outlined align-middle me-2">info</span>
                                    <strong>Demo Mod:</strong> Bu bir demo uygulamasıdır. Gerçek ödeme işlemi yapılmamaktadır.
                                </div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label fw-medium">Kart Numarası</label>
                                        <input type="text" class="form-control" placeholder="1234 5678 9012 3456" maxlength="19" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium">Son Kullanma Tarihi</label>
                                        <input type="text" class="form-control" placeholder="MM/YY" maxlength="5" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-medium">CVV</label>
                                        <input type="text" class="form-control" placeholder="123" maxlength="3" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sipariş Özeti -->
                    <div class="col-lg-4">
                        <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">Sipariş Özeti</h5>
                            </div>
                            <div class="card-body">
                                @foreach (var item in Model.Cart.CartItems)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="small">@item.Product?.Name</span>
                                            <span class="text-muted small">x@item.Quantity</span>
                                        </div>
                                        <span class="small fw-medium">₺@item.TotalPrice.ToString("N2")</span>
                                    </div>
                                }
                                <hr>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Ara Toplam</span>
                                    <span>₺@Model.Cart.TotalAmount.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Kargo</span>
                                    @if (Model.Cart.TotalAmount >= 100)
                                    {
                                        <span class="text-success">Ücretsiz</span>
                                    }
                                    else
                                    {
                                        <span>₺19.90</span>
                                    }
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="fw-bold">Toplam</span>
                                    <span class="fw-bold text-primary fs-4">
                                        ₺@((Model.Cart.TotalAmount + (Model.Cart.TotalAmount >= 100 ? 0 : 19.90m)).ToString("N2"))
                                    </span>
                                </div>
                                <button type="submit" class="btn btn-primary w-100 btn-lg">
                                    <span class="material-symbols-outlined align-middle me-2">check_circle</span>
                                    Siparişi Tamamla
                                </button>
                                <a asp-page="/Cart/Index" class="btn btn-outline-secondary w-100 mt-2">
                                    <span class="material-symbols-outlined align-middle me-1" style="font-size: 18px;">arrow_back</span>
                                    Sepete Dön
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="text-center py-5">
                <span class="material-symbols-outlined text-muted" style="font-size: 6rem;">shopping_cart</span>
                <h3 class="mt-3 text-muted">Sepetiniz boş</h3>
                <p class="text-muted mb-4">Ödeme yapabilmek için sepetinize ürün ekleyin.</p>
                <a asp-page="/Products/Index" class="btn btn-primary btn-lg">
                    <span class="material-symbols-outlined align-middle me-2">shopping_bag</span>
                    Alışverişe Başla
                </a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
